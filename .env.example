GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Paid OpenRouter is LOCAL DEVELOPMENT ONLY. Docker/Compose force production.
APP_ENV=production
LOCAL_OPENROUTER_ENABLED=false
# groq: free primary + local paid fallback on 429; openrouter: paid local tests
LOCAL_LLM_PROVIDER=groq
OPENROUTER_API_KEY=

# Optional hybrid semantic retrieval
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-large

# Optional remote image delivery (Cloudflare R2 public/custom domain)
ASSET_BASE_URL=

# R2 migration tooling only; never expose these values to the frontend
R2_ENDPOINT=
R2_BUCKET_NAME=krono
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional tuning
MAX_RETRIEVED_CHUNKS=10
MAX_CONTEXT_CHARS=28000
MAX_PLAN_CONTEXT_CHARS=22000
MAX_PLAN_SOURCES=96
MAX_CANDIDATE_IMAGES=24
MAX_RESPONSE_IMAGES=8
# Structured answers preserve whole image groups; legacy gallery keeps the limit above.
MAX_BLOCK_IMAGES=36
MAX_HISTORY_MESSAGES=10
# Absolute deadline for the entire chat request, including all generation batches.
CHAT_TIMEOUT_SECONDS=600
# Semantic model audit is disabled; enable only for explicit comparison experiments.
ENABLE_ANSWER_AUDIT=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
