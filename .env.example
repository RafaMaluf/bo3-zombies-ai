GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional hybrid semantic retrieval
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-large

# Optional remote image delivery (Cloudflare R2 public/custom domain)
ASSET_BASE_URL=

# R2 migration tooling only; never expose these values to the frontend
R2_ENDPOINT=
R2_BUCKET_NAME=krono
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional tuning
MAX_RETRIEVED_CHUNKS=10
MAX_MULTI_DOCUMENTS=3
MAX_CONTEXT_CHARS=28000
MAX_CANDIDATE_IMAGES=24
MAX_RESPONSE_IMAGES=8
MAX_HISTORY_MESSAGES=10
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
